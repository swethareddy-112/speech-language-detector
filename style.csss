```css
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea, #764ba2);

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;
}

.container {
    width: 100%;
    max-width: 650px;
}

.card {
    width: 100%;
    background: #ffffff;
    padding: 35px;
    border-radius: 20px;

    text-align: center;

    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
}

h1 {
    color: #333333;
    font-size: 32px;
    margin-bottom: 10px;
}

.subtitle {
    color: #666666;
    font-size: 16px;
    margin-bottom: 25px;
}

/* Language Selection */

.language-box {
    text-align: left;
    margin-bottom: 20px;
}

.language-box label {
    display: block;
    color: #333333;
    font-weight: bold;
    margin-bottom: 8px;
}

select {
    width: 100%;
    padding: 13px 15px;

    border: 2px solid #dddddd;
    border-radius: 10px;

    background: #ffffff;
    color: #333333;

    font-size: 16px;
    outline: none;

    cursor: pointer;
}

select:focus {
    border-color: #667eea;
}

/* Buttons */

button {
    border: none;
    padding: 13px 22px;
    margin: 5px;

    border-radius: 10px;

    font-size: 16px;
    font-weight: bold;

    color: white;
    background: #667eea;

    cursor: pointer;

    transition: 0.3s;
}

button:hover {
    background: #5568d9;
    transform: translateY(-2px);
}

button:disabled {
    background: #aaaaaa;
    cursor: not-allowed;
    transform: none;
}

.stop {
    background: #e74c3c;
}

.stop:hover {
    background: #c0392b;
}

/* Status */

.status {
    margin-top: 20px;
    padding: 13px;

    background: #f1f3f8;
    border-radius: 10px;

    color: #555555;
    font-size: 15px;
}

/* Detected Language */

.result {
    margin-top: 20px;
    padding: 20px;

    background: #f7f8ff;
    border-radius: 15px;

    border: 1px solid #eeeeee;
}

.result h2 {
    color: #444444;
    font-size: 20px;
    margin-bottom: 12px;
}

#detectedLanguage {
    color: #667eea;
    font-size: 28px;
    font-weight: bold;
}

/* Speech Text */

.transcript {
    margin-top: 20px;
    padding: 20px;

    background: #f7f8ff;
    border-radius: 15px;

    border: 1px solid #eeeeee;
}

.transcript h2 {
    color: #444444;
    font-size: 20px;
    margin-bottom: 12px;
}

#transcript {
    min-height: 60px;

    color: #555555;
    font-size: 16px;
    line-height: 1.6;

    word-wrap: break-word;
}

/* Mobile Screen */

@media (max-width: 600px) {

    body {
        padding: 12px;
    }

    .card {
        padding: 25px 18px;
    }

    h1 {
        font-size: 25px;
    }

    .subtitle {
        font-size: 14px;
    }

    button {
        width: 90%;
        margin: 6px auto;
    }

    #detectedLanguage {
        font-size: 24px;
    }
}
```
